# Copy to .env (gitignored) and fill in. Env vars override these.

# --- Generation backend (cv-tailor new / translate) -------------------------
# Anthropic (needs ANTHROPIC_API_KEY) or a local Ollama / OpenAI-compatible endpoint.
CV_TAILOR_PROVIDER=anthropic
CV_TAILOR_MODEL=claude-opus-4-8
# ANTHROPIC_API_KEY=sk-ant-...
# CV_TAILOR_PROVIDER=ollama
# CV_TAILOR_MODEL=qwen3.5:35b
# CV_TAILOR_OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Google Drive upload (cv-tailor upload) — see apps-script/README.md ------
APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXX/exec
APPS_SCRIPT_TOKEN=replace-with-the-apps-script-token
GDRIVE_FOLDER_ID=replace-with-the-drive-folder-id

# --- LinkedIn ingest (cv-tailor ingest, containerized) ----------------------
LINKEDIN_USER=you@example.com
LINKEDIN_PASS=your-password
VNC_PASSWORD=max8char

# Set to true to automatically start cv-tailor hunt on container boot. Default: false
SCRAPE_JOBS=false

# Set to false to bypass automated login and wait for manual login via VNC. Default: true
LOGIN_ON_START=true

# --- PostgreSQL Database (used for job metadata and applications) ----------
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cv_tailor

