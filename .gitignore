# build output
/site/
# python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
# local secrets — never commit (incl. backups like .env.bak.*)
.env
.env.*
!.env.example
# private runtime data (browser profile, captured JDs, challenge screenshots) — never commit
/vault/
# generated PDFs (built in CI / locally)
*.pdf

# benchmark artifacts (regenerate with tests/experiments/run.py + evaluate.py)
/tests/experiments/outputs/
/tests/experiments/results/
tests/experiments/_*.log

# LaTeX build artefacts (PDFs go to Drive; .tex is committed)
*.aux
*.fls
*.fdb_latexmk
*.synctex.gz
applications/*/*.log
*.out
