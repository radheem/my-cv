# cv-tailor PostgreSQL MCP Server runtime — lightweight Python service.
FROM python:3.12-slim

WORKDIR /app

# Install system dependencies (none are strictly required for psycopg-binary/mcp)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install python dependencies first to cache layers
COPY pyproject.toml README.md ./
COPY engine ./engine

# Install psycopg[binary] and mcp[cli]
RUN pip install --no-cache-dir -e ".[mcp]"

# Set environment defaults
ENV PYTHONPATH=/app \
    MCP_TRANSPORT=streamable-http \
    PGHOST=db \
    PGPORT=5432 \
    PGDATABASE=cv_tailor \
    PGUSER=postgres \
    PGPASSWORD=postgres

EXPOSE 5000

CMD ["python", "-m", "engine.mcp.server"]
